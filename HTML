<!DOCTYPE html>
<html>
<head>
    <title>4 Section Layout</title>

    <style>
        /* Common style for all sections */
        .box {
            width: 50%;
            height: 50vh;
            float: left;
            text-align: center;
            line-height: 50vh;
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        /* Different background colors */
        #box1 { background-color: red; }
        #box2 { background-color: blue; }
        #box3 { background-color: green; }
        #box4 { background-color: purple; }
    </style>
</head>

<body>

    <div class="box" id="box1">Section 1</div>
    <div class="box" id="box2">Section 2</div>
    <div class="box" id="box3">Section 3</div>
    <div class="box" id="box4">Section 4</div>

</body>
</html>
