<!DOCTYPE html>
<html>
<head>
    <title>College Website</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
        }

        /* Navigation Bar */
        .navbar {
            background-color: darkblue;
            padding: 10px;
            text-align: center;
        }

        .navbar a {
            color: white;
            margin: 15px;
            text-decoration: none;
            font-size: 18px;
        }

        /* Banner */
        .banner img {
            width: 100%;
            height: 300px;
        }

        /* Departments Section */
        .departments {
            padding: 20px;
        }

        .departments ul {
            list-style-type: square;
        }

        /* Footer */
        .footer {
            background-color: darkblue;
            color: white;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <div class="navbar">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Departments</a>
        <a href="#">Contact</a>
    </div>

    <!-- Banner Image -->
    <div class="banner">
        <img src="college.jpg" alt="College Banner">
    </div>

    <!-- Departments Section -->
    <div class="departments">
        <h2>Departments</h2>
        <ul>
            <li>Computer Science</li>
            <li>Mechanical Engineering</li>
            <li>Electrical Engineering</li>
            <li>Civil Engineering</li>
        </ul>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>Contact: info@college.com | Phone: 1234567890</p>
    </div>

</body>
</html>
